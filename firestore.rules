rules_version = '2';
// กฎความปลอดภัย Firestore (ฉบับรวม) โปรเจกต์ sportday69-c54a4
// ใช้ร่วมกัน 3 ระบบ ข้อมูลแยกกันคนละ collection ไม่ปนกัน
//
// [ระบบกีฬาภายใน 2569 — ของเดิม ไม่ได้เปลี่ยน]
// - live/state        : ผลการแข่งขัน ทุกคนอ่านได้ เขียนได้เฉพาะ admin
// - surveys/{id}      : แบบประเมินกีฬาสี ทุกคนส่งได้ (เพิ่มอย่างเดียว) อ่าน/ลบได้เฉพาะ admin
// - settings/survey   : เปิด/ปิดรับแบบประเมินกีฬาสี
//
// [ระบบประเมินการประชุมผู้ปกครอง 22 พ.ย. 2569 — ของเดิม ไม่ได้เปลี่ยน]
// - pmeet/{id}        : แบบประเมินการประชุมผู้ปกครอง ทุกคนส่งได้ (เพิ่มอย่างเดียว) อ่าน/ลบได้เฉพาะ admin
// - settings/pmeet    : เปิด/ปิดรับแบบประเมินการประชุมผู้ปกครอง
//
// [ระบบสนามสอบธรรมสนามหลวง 2569 — เพิ่มใหม่]
// - dhamma_rooms/{id} : ห้องสอบ + รายชื่อผู้เข้าสอบ + กรรมการกำกับห้อง ทุกคนอ่านได้ เขียนได้เฉพาะ admin
// - dhamma_site/{id}  : config (ข้อมูลการสอบ/ประกาศ/แผนผัง) และ committee (คำสั่งแต่งตั้ง) ทุกคนอ่านได้ เขียนได้เฉพาะ admin
// - dhamma_surveys/{id} : แบบประเมินความพึงพอใจ ทุกคนส่งได้ (เพิ่มอย่างเดียว) อ่าน/ลบได้เฉพาะ admin
//                       เปิด/ปิดรับด้วย dhamma_site/config.surveyOpen
//
// อีเมล admin ต้องตรงกับ adminEmail ใน js/config.js ของทุกระบบ
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'waroon01@gmail.com';
    }

    function surveyOpen() {
      return !exists(/databases/$(database)/documents/settings/survey)
          || get(/databases/$(database)/documents/settings/survey).data.get('open', true) == true;
    }

    function pmeetOpen() {
      return !exists(/databases/$(database)/documents/settings/pmeet)
          || get(/databases/$(database)/documents/settings/pmeet).data.get('open', true) == true;
    }

    function shortText(t, k) {
      return t.get(k, '') is string && t.get(k, '').size() <= 1000;
    }

    /* ---------- กีฬาภายใน (เดิม) ---------- */
    function validSurvey(d) {
      return d.keys().hasOnly(['group', 'demo', 'ans', 'text', 'v', 'createdAt'])
          && d.group in ['teacher', 'student', 'parent']
          && d.demo is map && d.demo.size() <= 12
          && d.ans is map && d.ans.size() >= 5 && d.ans.size() <= 40
          && d.text is map && d.text.keys().hasOnly(['like', 'problem', 'addsport', 'suggest'])
          && shortText(d.text, 'like') && shortText(d.text, 'problem')
          && shortText(d.text, 'addsport') && shortText(d.text, 'suggest')
          && d.createdAt == request.time;
    }

    /* ---------- ประชุมผู้ปกครอง (เดิม) ---------- */
    function validPmeet(d) {
      return d.keys().hasOnly(['group', 'demo', 'ans', 'text', 'v', 'createdAt'])
          && d.group == 'parent'
          && d.demo is map && d.demo.size() <= 10
          && d.ans is map && d.ans.size() >= 5 && d.ans.size() <= 40
          && d.text is map && d.text.keys().hasOnly(['like', 'want', 'suggest'])
          && shortText(d.text, 'like') && shortText(d.text, 'want') && shortText(d.text, 'suggest')
          && d.createdAt == request.time;
    }

    /* ---------- ธรรมสนามหลวง (ใหม่) ---------- */
    function validDhammaRoom(d) {
      return d.level in ['tri', 'tho', 'ek']
          && d.stage in ['p', 'm']
          && d.roomNo is int && d.roomNo >= 1 && d.roomNo <= 30
          && d.students is list && d.students.size() <= 60
          && d.proctors is list && d.proctors.size() <= 6;
    }

    /* ---------- ธรรมสนามหลวง: แบบประเมินความพึงพอใจ (ใหม่) ---------- */
    function dhammaSurveyOpen() {
      return !exists(/databases/$(database)/documents/dhamma_site/config)
          || get(/databases/$(database)/documents/dhamma_site/config).data.get('surveyOpen', true) == true;
    }

    function likert(m, k) {
      return m[k] is int && m[k] >= 1 && m[k] <= 5;
    }

    // ข้อคำถามต้องตรงกับ assets/js/survey-questions.js
    function validDhammaSurvey(d) {
      return d.keys().hasOnly(['group', 'ans', 'text', 'v', 'createdAt'])
          && d.group in ['monk', 'teacher', 'student', 'helper', 'other']
          && d.ans is map
          && d.ans.keys().hasOnly(['q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'q7', 'q8', 'q9', 'q10', 'q11', 'q12', 'q13'])
          && d.ans.size() == 13
          && likert(d.ans, 'q1') && likert(d.ans, 'q2') && likert(d.ans, 'q3') && likert(d.ans, 'q4')
          && likert(d.ans, 'q5') && likert(d.ans, 'q6') && likert(d.ans, 'q7') && likert(d.ans, 'q8')
          && likert(d.ans, 'q9') && likert(d.ans, 'q10') && likert(d.ans, 'q11') && likert(d.ans, 'q12')
          && likert(d.ans, 'q13')
          && d.text is map && d.text.keys().hasOnly(['like', 'suggest'])
          && shortText(d.text, 'like') && shortText(d.text, 'suggest')
          && d.v is int
          && d.createdAt == request.time;
    }

    match /live/state {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /surveys/{id} {
      allow create: if surveyOpen() && validSurvey(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /pmeet/{id} {
      allow create: if pmeetOpen() && validPmeet(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /settings/survey {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/pmeet {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dhamma_rooms/{roomId} {
      allow read: if true;
      allow create, update: if isAdmin() && validDhammaRoom(request.resource.data);
      allow delete: if isAdmin();
    }

    match /dhamma_site/{docId} {
      allow read: if docId in ['config', 'committee'];
      allow write: if isAdmin() && docId in ['config', 'committee'];
    }

    match /dhamma_surveys/{id} {
      allow create: if dhammaSurveyOpen() && validDhammaSurvey(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
